[Unit]
Description=Okello Robot Server
After=network.target

[Service]
Type=simple
User=okello
WorkingDirectory=/home/okello/OkelloServer
Environment="OKELLO_DEVICE=/dev/ttyACM0"
Environment="OKELLO_PORT=5000"
ExecStart=/home/okello/OkelloServer/venv/bin/python okello_server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
